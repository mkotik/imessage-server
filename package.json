{
  "name": "imessage-server",
  "version": "0.1.0",
  "private": true,
  "description": "VPS side of the personal iMessage archive: authenticated ingestion, encrypted message database, client-encrypted attachments in iDrive E2, and a dedicated MCP server.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "migrate": "node dist/src/tools/migrate.js",
    "start:ingest": "node dist/src/ingest/server.js",
    "start:mcp": "node dist/src/mcp/server.js",
    "backup": "node dist/src/tools/backup.js",
    "restore": "node dist/src/tools/restore.js",
    "verify-encryption": "node dist/src/tools/verify-encryption.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
