# imessage-server configuration — NAMES ONLY, never real values.
# Production values live at /etc/imessage-server/secrets.env (root:imsg 0640),
# loaded by systemd via EnvironmentFile= before privileges are dropped.

# ---- Encryption (required) ----
# 64 hex characters = 32 bytes. Generate with: openssl rand -hex 32
IMSG_DB_KEY_HEX=
IMSG_ATTACHMENT_MASTER_KEY_HEX=

# ---- Ingestion auth (required) ----
# Shared bearer secret the Mac sender presents. openssl rand -base64 36
IMSG_INGEST_TOKEN=

# ---- Cloudflare Access (required for both services) ----
# Not secret; these are public identifiers.
CF_ACCESS_TEAM_DOMAIN=
# Ingestion Access application AUD tag
IMSG_INGEST_CF_ACCESS_AUD=
# MCP Access application AUD tag (a DIFFERENT application)
IMSG_MCP_CF_ACCESS_AUD=

# ---- iDrive E2 object storage (required) ----
E2_ENDPOINT=
E2_REGION=
E2_BUCKET=
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# ---- Paths ----
IMSG_DB_PATH=/var/lib/imessage/messages.db
IMSG_TMP_DIR=/var/lib/imessage/tmp

# ---- Binds (loopback only; never 0.0.0.0) ----
IMSG_INGEST_HOST=127.0.0.1
IMSG_INGEST_PORT=3100
IMSG_MCP_HOST=127.0.0.1
IMSG_MCP_PORT=3200

# Comma-separated public hostname allowlist, validated at the origin.
IMSG_INGEST_PUBLIC_HOSTNAME=
IMSG_MCP_PUBLIC_HOSTNAME=

# ---- Limits ----
IMSG_MAX_BATCH_BYTES=33554432
IMSG_MAX_MESSAGES_PER_BATCH=1000
IMSG_MAX_ATTACHMENT_BYTES=104857600
# Largest attachment returned inline (base64) by the MCP get_attachment tool.
IMSG_MAX_INLINE_ATTACHMENT_BYTES=5242880

# ---- Logging ----
IMSG_LOG_LEVEL=info

# ---- Optional behaviour ----
# Drop messages whose sender looks like a short code (5-6 digits). The Mac sender
# already applies this; the server defaults to false so it never silently discards
# automated mail the Mac deliberately forwarded.
IMSG_FILTER_SHORTCODE_SENDERS=false
# Pin the exact Cloudflare Access service token allowed to reach ingestion.
IMSG_INGEST_CF_ACCESS_CLIENT_ID=
